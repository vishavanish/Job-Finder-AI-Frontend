{
  "manifest_version": 3,
  "name": "Job Finder",
  "version": "0.2.0",
  "description": "Save the jobs on the job-search page you're looking at to Job Finder AI, and let Job Finder fill LinkedIn Easy Apply forms when you start Fast apply (you submit).",
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Job Finder"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["storage"],
  "host_permissions": ["https://jobfinderai.duckdns.org/*", "http://localhost:8000/*"],
  "content_scripts": [
    {
      "matches": [
        "https://*.naukri.com/*",
        "https://*.foundit.in/*",
        "https://*.foundit.com/*",
        "https://*.monsterindia.com/*",
        "https://*.glassdoor.com/*",
        "https://*.glassdoor.co.in/*",
        "https://*.glassdoor.co.uk/*",
        "https://*.glassdoor.ca/*",
        "https://*.linkedin.com/jobs/*",
        "https://*.indeed.com/*",
        "https://*.indeed.co.in/*",
        "https://*.indeed.co.uk/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://*.linkedin.com/jobs/*"],
      "js": ["assist.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/reader.js"],
      "matches": [
        "https://*.naukri.com/*",
        "https://*.foundit.in/*",
        "https://*.foundit.com/*",
        "https://*.monsterindia.com/*",
        "https://*.glassdoor.com/*",
        "https://*.glassdoor.co.in/*",
        "https://*.glassdoor.co.uk/*",
        "https://*.glassdoor.ca/*",
        "https://*.linkedin.com/*",
        "https://*.indeed.com/*",
        "https://*.indeed.co.in/*",
        "https://*.indeed.co.uk/*"
      ]
    },
    {
      "resources": ["src/linkedin_apply.js", "src/formreader.js", "src/filler.js"],
      "matches": ["https://*.linkedin.com/*"]
    }
  ]
}
