# Loaded by `npm run build` (Vercel). Committed: holds no secrets.
# Empty = call /api/v1 on the app's own origin: vercel.json forwards /api/* to the server, so the
# refresh cookie is first-party and survives reloads (QA1 §1).
VITE_API_BASE_URL=
# Vercel can't forward WebSockets, so voice sockets go straight to the server.
VITE_WS_ORIGIN=https://jobfinderai.duckdns.org
VITE_USE_MOCKS=false
# Google sign-in web client id (public, not a secret). Must also be in the backend GOOGLE_CLIENT_IDS.
VITE_GOOGLE_CLIENT_ID=776583907200-shlkg5ugq4565qca77d8fubpi0ceb9qj.apps.googleusercontent.com
