# Copy to .env.local to override per machine (.env.local is git-ignored).
# Backend origin without /api/v1. Empty = same origin (the dev proxy in vite.config.ts).
VITE_API_BASE_URL=
# true = answer API calls from MSW mocks (src/mocks) instead of the backend.
VITE_USE_MOCKS=false
# Dev proxy target for /api when VITE_API_BASE_URL is empty.
DEV_API_PROXY_TARGET=http://127.0.0.1:8000
# Google OAuth *web* client id (public). Must also be listed in the backend's GOOGLE_CLIENT_IDS,
# and this origin added under "Authorized JavaScript origins" in Google Cloud. Empty = no Google button.
VITE_GOOGLE_CLIENT_ID=
