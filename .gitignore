# ---- dependencies ----
node_modules/
.pnp
.pnp.js

# ---- build output ----
build/
dist/
.next/
out/

# ---- environment variables ----
# Every .env file is ignored except these four, which hold no secrets (VITE_* values are
# public: they end up in the browser bundle). Vercel builds from .env.production.
.env
.env.*
!.env.example
!.env.development
!.env.mocks
!.env.production

# ---- logs ----
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ---- editor / OS ----
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp

# ---- testing ----
coverage/
test-results/
playwright-report/

# ---- tool caches ----
*.tsbuildinfo
.eslintcache

# ---- misc ----
*.local
.cache/
.parcel-cache/

# ---- package manager locks (optional — many teams DO commit these; remove this line if you want yours tracked) ----
# package-lock.json
# yarn.lock
# pnpm-lock.yaml