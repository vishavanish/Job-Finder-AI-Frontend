# Loaded by `npm run dev`. Committed: holds no secrets (never put secrets in VITE_* vars).
# Empty = call /api/v1 on the dev server's own origin; vite.config.ts proxies it.
VITE_API_BASE_URL=
VITE_USE_MOCKS=false
# Where the dev proxy sends /api (not exposed to the browser bundle).
DEV_API_PROXY_TARGET=http://127.0.0.1:8000
